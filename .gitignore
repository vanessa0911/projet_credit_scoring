# =========================
# Projet Credit Scoring (.gitignore)
# =========================

# --- Python / build ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.dll
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
site/

# --- Environnements virtuels ---
.venv/
venv/
env/
ENV/

# --- Logs & caches ---
*.log
.cache/
.mypy_cache/
.pytype/
.dmypy.json
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace

# --- Config locales (optionnelles) ---
.env
.env.*

# --- Données brutes (gros fichiers locaux) ---
data/
!data/.gitkeep
!data/README.md

# --- Artifacts ---
# On conserve les modèles/metrics par défaut.
# On ignore seulement des sous-dossiers temporaires.
artifacts/tmp/
artifacts/cache/

# --- Divers ---
*.tmp
*.bak

kaggle.json
.kaggle/
**/kaggle.json
data/*.csv
data/*.zip
artifacts/*.csv
artifacts/*.json
