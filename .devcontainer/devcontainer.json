{
  "name": "credit-scoring (py3.12)",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip setuptools wheel && pip install -r requirements.txt --no-cache-dir",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": { "label": "FastAPI" },
    "8501": { "label": "Streamlit" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
